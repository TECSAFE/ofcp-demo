# Copy to api/.env for local dev: cp api/.env.example api/.env
# Every variable is REQUIRED unless marked optional — there are no code
# defaults; the API refuses to boot when a required one is missing.
PORT=4000
UI_ORIGIN=http://localhost:3000
DATA_DIR=./data
OFCP_GATEWAY_URL=https://ofcp-api-gateway.staging.tecsafe.de
# Optional: /tecsafe token endpoints answer 503 until set.
OFCP_SALESCHANNEL_API_KEY=
GUEST_SESSION_TTL_DAYS=7
SESSION_TTL_DAYS=30
USER_TTL_DAYS=90
# Optional: POST /whitelabel-shares answers 503 until set.
WHITELABEL_SHARE_SECRET=
